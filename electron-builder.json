{
  "appId": "io.github.wonby1n.tidewatch",
  "productName": "Tidewatch",
  "artifactName": "Tidewatch-Setup.exe",
  "protocols": [{ "name": "Tidewatch session", "schemes": ["tidewatch"] }],
  "directories": { "output": "release/installer" },
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "skills/tidewatch/assets/tidewatch.ico",
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "Tidewatch",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "installerIcon": "skills/tidewatch/assets/tidewatch.ico",
    "uninstallerIcon": "skills/tidewatch/assets/tidewatch.ico",
    "installerLanguages": ["en_US", "ko_KR"],
    "language": "1042"
  }
}
